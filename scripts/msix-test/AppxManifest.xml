<?xml version="1.0" encoding="utf-8"?>
<!-- Template for scripts/msix-test/build.ps1: a test package that declares the
     StartupTask the packaged login-startup backend uses (#153). The task Id
     and Parameters must match crates/ui/src/autostart.rs. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="@IDENTITY@" Publisher="@SUBJECT@" Version="0.0.1.0" ProcessorArchitecture="@ARCH@" />
  <Properties>
    <DisplayName>CayenChat Test</DisplayName>
    <PublisherDisplayName>CayenChat</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="CayenChat" Executable="cayenchat.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="CayenChat Test"
        Description="CayenChat test package for the login startup setting"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="cayenchat.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="CayenChat" Enabled="false" DisplayName="CayenChat" Parameters="--autostart" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
